datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  fullName        String   @map("full_name")
  branch          String
  batchYear       Int      @map("batch_year")
  reputationScore Decimal  @default(5.00) @map("reputation_score") @db.Decimal(3, 2)
  totalRatings    Int      @default(0) @map("total_ratings")
  createdAt       DateTime @default(now()) @map("created_at")

  ridesHosted        Ride[]            @relation("HostRides")
  rideParticipations RideParticipant[]
  ratingsGiven       Rating[]          @relation("RatingsGiven")
  ratingsReceived    Rating[]          @relation("RatingsReceived")
}

enum RideType {
  cab_pool
  rickshaw_pool
}

enum RideStatus {
  open
  matched
  in_transit
  completed
  cancelled
}

model Ride {
  id                 String     @id @default(uuid())
  hostUserId         String     @map("host_user_id")
  host               User       @relation("HostRides", fields: [hostUserId], references: [id], onDelete: Cascade)
  type               RideType   @default(cab_pool)
  origin             String
  destination        String
  departureTime      DateTime   @map("departure_time")
  maxSeats           Int        @default(4) @map("max_seats")
  currentSeatsFilled Int        @default(1) @map("current_seats_filled")
  status             RideStatus @default(open)
  createdAt          DateTime   @default(now()) @map("created_at")

  participants RideParticipant[]
}

model RideParticipant {
  id       String   @id @default(uuid())
  rideId   String   @map("ride_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rideId, userId])
}

model Rating {
  id         String   @id @default(uuid())
  rideId     String?  @map("ride_id")
  deliveryId String?  @map("delivery_id")
  raterId    String   @map("rater_id")
  rateeId    String   @map("ratee_id")
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  rater User @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  ratee User @relation("RatingsReceived", fields: [rateeId], references: [id], onDelete: Cascade)

  @@unique([rideId, raterId])
}
